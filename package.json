{
  "name": "abii",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/quiz/distractors.test.mjs lib/quiz/finish-response.test.mjs lib/sounds-core.test.mjs lib/sounds-engine.test.mjs && npm run test:topics && npm run test:topic-routes && npm run test:auth-email && npm run test:auth-ui && npm run test:auth-login && npm run test:profile-crop && npm run test:landing-demo && npm run test:demo",
    "test:profile-crop": "node --conditions=react-server --import ./scripts/register-typescript.mjs --test scripts/profile-crop.test.ts",
    "test:landing-demo": "node --conditions=react-server --import ./scripts/register-typescript.mjs --test scripts/landing-demo-grading.test.ts",
    "test:demo": "node --conditions=react-server --import ./scripts/register-typescript.mjs --test scripts/demo-seed.test.ts",
    "test:auth-email": "node --conditions=react-server --import ./scripts/register-typescript.mjs --test scripts/auth-email.test.ts",
    "test:support": "node --conditions=react-server --import ./scripts/register-typescript.mjs --test scripts/support.test.ts",
    "test:auth-ui": "node --conditions=react-server --import ./scripts/register-typescript.mjs --test scripts/auth-otp-input.test.ts",
    "test:auth-login": "node --test scripts/auth-login-routes.test.mjs",
    "test:topic-routes": "node --test scripts/topic-routes.test.mjs",
    "test:topics": "node --conditions=react-server --import ./scripts/register-typescript.mjs --test --test-concurrency=1 scripts/folders.test.ts scripts/subject-folders.test.ts scripts/topics.test.ts scripts/topic-api.test.ts scripts/mastery.test.ts scripts/quiz-answer.test.ts scripts/quiz-compatibility.test.ts scripts/quiz-session-resume.test.ts scripts/quiz-round-priority.test.ts scripts/badges.test.ts scripts/achievements-persistence.test.ts scripts/badge-reconciliation.test.ts scripts/badge-evaluator.test.ts scripts/badge-page.test.ts scripts/badges-route.test.mjs",
    "migrate:topics": "node --conditions=react-server --import ./scripts/register-typescript.mjs scripts/migrate-topics.ts",
    "reconcile:badges": "node --conditions=react-server --import ./scripts/register-typescript.mjs scripts/reconcile-badges.ts",
    "seed:demo": "node --conditions=react-server --import ./scripts/register-typescript.mjs scripts/seed-demo-account.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.0",
    "lucide-react": "^1.61.0",
    "mongodb-connection-string-url": "^3.0.2",
    "mongoose": "^8.19.1",
    "motion": "^14.9.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
